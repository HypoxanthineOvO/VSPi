{
  "name": "vspi",
  "version": "2.0.0",
  "private": true,
  "description": "VSPi client for the VSP agent runtime.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vspi": "dist/main.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx --import ../../build/register-raw-text-loader.mjs src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package:stage": "node scripts/stage-package.mjs .tmp/package-stage",
    "package:pack": "pnpm run build && pnpm run package:stage && mkdir -p .tmp/package-artifacts && npm pack .tmp/package-stage --pack-destination .tmp/package-artifacts",
    "package:verify": "node scripts/verify-package.mjs",
    "clean": "rm -rf dist .tmp/package-stage .tmp/package-artifacts"
  },
  "dependencies": {
    "@moonshot-ai/kap-server": "workspace:^",
    "@moonshot-ai/klient": "workspace:^",
    "@moonshot-ai/minidb": "workspace:^",
    "@moonshot-ai/pi-tui": "workspace:^",
    "@vsp/vsp-runtime": "workspace:^",
    "chalk": "^5.4.1",
    "grok-mermaid": "0.2.2",
    "highlight.js": "10.7.3",
    "marked": "18.0.5",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "vitest": "4.1.4"
  }
}
