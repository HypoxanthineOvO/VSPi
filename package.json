{
  "name": "vspi",
  "version": "0.2.4",
  "description": "A Chinese terminal UI for Pi coding agents with optional read-only Hypo-Workflow integration.",
  "homepage": "https://gitlab.vsplab.cn/heyx/vspi",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.vsplab.cn/heyx/vspi.git"
  },
  "bugs": {
    "url": "https://gitlab.vsplab.cn/heyx/vspi/-/issues"
  },
  "type": "module",
  "bin": {
    "vspi": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "Docs/tui-v1.md",
    "Docs/harness"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "bridge": "tsx src/index.ts bridge",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "check": "tsc --noEmit && biome check src test scripts",
    "check:fix": "biome check --write src test scripts",
    "harness:check": "tsx scripts/harness-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "VSPi_FIXTURE=1 VSPi_REDUCED_MOTION=1 tsx src/index.ts --render-once"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "terminal",
    "tui"
  ],
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "chalk": "5.6.2",
    "highlight.js": "10.7.3",
    "marked": "18.0.5",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/node": "24.1.0",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
